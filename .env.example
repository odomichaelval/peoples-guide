# ---- People's Guide configuration ----
# Copy to .env (scripts/setup.sh does this for you) and adjust.

# Ollama runs locally on the DGX Spark - nothing leaves the machine.
OLLAMA_HOST=http://127.0.0.1:11434
CHAT_MODEL=nemotron-3-nano
EMBED_MODEL=nomic-embed-text
# Nemotron 3 can "think" before answering. Off = faster demo responses.
OLLAMA_THINK=false
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=300

# Auth - CHANGE THIS SECRET (setup.sh generates a random one)
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=480

# Demo login created by setup.sh (change before the demo!)
DEMO_USERNAME=demo
DEMO_PASSWORD=PeoplesGuide2026!

# RAG
RAG_TOP_K=8
API_PORT=8000
